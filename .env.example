# Sao chép thành .env và điền giá trị. App vẫn chạy khi thiếu key (gợi ý dùng template, tắt TTS).

# Gợi ý bằng LLM và đọc chậm (TTS)
OPENAI_API_KEY=

# Tuỳ chọn: lớp tham khảo "đúng chuẩn" (so với text)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Nơi lưu video, audio, feature bản gốc và SQLite
# Service Python tự expand `~`, không cần viết đường dẫn tuyệt đối
DATA_DIR=~/shadowenglab-data
