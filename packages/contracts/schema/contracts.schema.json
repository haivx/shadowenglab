{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Segment": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "endExtraMs": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Word"
          }
        },
        "translation": {
          "type": "string"
        }
      },
      "required": [
        "index",
        "text",
        "start",
        "end",
        "words"
      ]
    },
    "Word": {
      "type": "object",
      "properties": {
        "i": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "asrProb": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ipa": {
          "type": "string"
        },
        "refConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "prominence": {
          "type": "number"
        }
      },
      "required": [
        "i",
        "text",
        "start",
        "end",
        "asrProb"
      ]
    },
    "Lesson": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "videoId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "durationSec": {
          "type": "number",
          "minimum": 0
        },
        "thumbnailUrl": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/TimeRange"
        },
        "padMs": {
          "default": 150,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "downloading",
            "separating",
            "transcribing",
            "segmenting",
            "analyzing",
            "ready",
            "failed"
          ]
        },
        "error": {
          "$ref": "#/$defs/LessonError"
        },
        "audioQuality": {
          "$ref": "#/$defs/AudioQuality"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Segment"
          }
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "videoId",
        "title",
        "durationSec",
        "range",
        "status",
        "segments",
        "createdAt"
      ]
    },
    "TimeRange": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "LessonError": {
      "type": "object",
      "properties": {
        "step": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "step",
        "message"
      ]
    },
    "AudioQuality": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "clean",
            "music"
          ]
        },
        "nonVocalRatio": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "label",
        "nonVocalRatio"
      ]
    },
    "ScoreResult": {
      "type": "object",
      "properties": {
        "lessonId": {
          "type": "string"
        },
        "segmentIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "string",
          "enum": [
            "full",
            "intonationOnly"
          ]
        },
        "versions": {
          "$ref": "#/$defs/Versions"
        },
        "timingMs": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "scores": {
          "$ref": "#/$defs/Scores"
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WordScore"
          }
        },
        "prosody": {
          "$ref": "#/$defs/Prosody"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        },
        "tips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tip"
          }
        }
      },
      "required": [
        "lessonId",
        "segmentIndex",
        "attempt",
        "mode",
        "versions",
        "timingMs",
        "scores",
        "words",
        "prosody",
        "issues",
        "tips"
      ]
    },
    "Versions": {
      "type": "object",
      "properties": {
        "scorer": {
          "type": "string"
        },
        "thresholds": {
          "type": "string"
        }
      },
      "required": [
        "scorer",
        "thresholds"
      ]
    },
    "Scores": {
      "type": "object",
      "properties": {
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sound": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "intonation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rhythm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "overall",
        "sound",
        "intonation",
        "rhythm"
      ]
    },
    "WordScore": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "scored",
            "missing",
            "ref_unclear"
          ]
        },
        "similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "refPhones": {
          "type": "string"
        },
        "userPhones": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "status",
        "similarity",
        "start",
        "end"
      ]
    },
    "Prosody": {
      "type": "object",
      "properties": {
        "speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pitchRange": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "melodyMatch": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "contour": {
          "$ref": "#/$defs/Contour"
        },
        "stress": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StressEntry"
          }
        },
        "pauses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PauseEntry"
          }
        }
      },
      "required": [
        "speed",
        "pitchRange",
        "melodyMatch",
        "contour",
        "stress",
        "pauses"
      ]
    },
    "Contour": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "user": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "wordBounds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "ref",
        "user",
        "wordBounds"
      ]
    },
    "StressEntry": {
      "type": "object",
      "properties": {
        "word": {
          "type": "string"
        },
        "ref": {
          "type": "number"
        },
        "user": {
          "type": "number"
        }
      },
      "required": [
        "word",
        "ref",
        "user"
      ]
    },
    "PauseEntry": {
      "type": "object",
      "properties": {
        "afterWord": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "refMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "userMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "afterWord",
        "refMs",
        "userMs"
      ]
    },
    "Issue": {
      "oneOf": [
        {
          "$ref": "#/$defs/StressMismatchIssue"
        },
        {
          "$ref": "#/$defs/ExtraPauseIssue"
        },
        {
          "$ref": "#/$defs/FinalContourIssue"
        },
        {
          "$ref": "#/$defs/FlatPitchIssue"
        },
        {
          "$ref": "#/$defs/PitchDeviationIssue"
        },
        {
          "$ref": "#/$defs/PhoneIssue"
        },
        {
          "$ref": "#/$defs/WordMissingIssue"
        }
      ]
    },
    "StressMismatchIssue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "STRESS_MISMATCH"
        },
        "wordIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "data": {
          "$ref": "#/$defs/StressMismatchData"
        }
      },
      "required": [
        "code",
        "wordIndex",
        "data"
      ]
    },
    "StressMismatchData": {
      "type": "object",
      "properties": {
        "refWord": {
          "type": "string"
        },
        "userWord": {
          "type": "string"
        }
      },
      "required": [
        "refWord",
        "userWord"
      ]
    },
    "ExtraPauseIssue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "EXTRA_PAUSE"
        },
        "wordIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "data": {
          "$ref": "#/$defs/ExtraPauseData"
        }
      },
      "required": [
        "code",
        "wordIndex",
        "data"
      ]
    },
    "ExtraPauseData": {
      "type": "object",
      "properties": {
        "refMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "userMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "refMs",
        "userMs"
      ]
    },
    "FinalContourIssue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "FINAL_CONTOUR"
        },
        "data": {
          "$ref": "#/$defs/FinalContourData"
        }
      },
      "required": [
        "code",
        "data"
      ]
    },
    "FinalContourData": {
      "type": "object",
      "properties": {
        "refSlope": {
          "type": "number"
        },
        "userSlope": {
          "type": "number"
        }
      },
      "required": [
        "refSlope",
        "userSlope"
      ]
    },
    "FlatPitchIssue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "FLAT_PITCH"
        },
        "data": {
          "$ref": "#/$defs/FlatPitchData"
        }
      },
      "required": [
        "code",
        "data"
      ]
    },
    "FlatPitchData": {
      "type": "object",
      "properties": {
        "pitchRange": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "pitchRange"
      ]
    },
    "PitchDeviationIssue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "PITCH_DEVIATION"
        },
        "wordIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "data": {
          "$ref": "#/$defs/PitchDeviationData"
        }
      },
      "required": [
        "code",
        "wordIndex",
        "data"
      ]
    },
    "PitchDeviationData": {
      "type": "object",
      "properties": {
        "meanDiffSt": {
          "type": "number"
        }
      },
      "required": [
        "meanDiffSt"
      ]
    },
    "PhoneIssue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "PHONE"
        },
        "wordIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "data": {
          "$ref": "#/$defs/PhoneData"
        }
      },
      "required": [
        "code",
        "wordIndex",
        "data"
      ]
    },
    "PhoneData": {
      "type": "object",
      "properties": {
        "refPhones": {
          "type": "string"
        },
        "userPhones": {
          "type": "string"
        },
        "similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "refPhones",
        "userPhones",
        "similarity"
      ]
    },
    "WordMissingIssue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "WORD_MISSING"
        },
        "wordIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "data": {
          "$ref": "#/$defs/WordMissingData"
        }
      },
      "required": [
        "code",
        "wordIndex",
        "data"
      ]
    },
    "WordMissingData": {
      "type": "object",
      "properties": {}
    },
    "Tip": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "issueRef": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source": {
          "type": "string",
          "enum": [
            "template",
            "llm"
          ]
        }
      },
      "required": [
        "text",
        "issueRef",
        "source"
      ]
    },
    "IssueCode": {
      "type": "string",
      "enum": [
        "STRESS_MISMATCH",
        "EXTRA_PAUSE",
        "FINAL_CONTOUR",
        "FLAT_PITCH",
        "PITCH_DEVIATION",
        "PHONE",
        "WORD_MISSING"
      ]
    },
    "ClipManifest": {
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string"
        },
        "videoId": {
          "type": "string"
        },
        "sentenceText": {
          "type": "string"
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClipWord"
          }
        },
        "refAudio": {
          "type": "string"
        },
        "userAudio": {
          "type": "string"
        },
        "gold": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "identical",
            "wrong"
          ]
        },
        "systemScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "clipId",
        "videoId",
        "sentenceText",
        "words",
        "refAudio",
        "userAudio"
      ]
    },
    "ClipWord": {
      "type": "object",
      "properties": {
        "i": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "i",
        "text"
      ]
    },
    "Label": {
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string"
        },
        "raterId": {
          "type": "string"
        },
        "overall": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 3
            },
            {
              "type": "number",
              "const": 4
            },
            {
              "type": "number",
              "const": 5
            }
          ]
        },
        "wordFlags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WordFlags"
          }
        },
        "finalContourMatch": {
          "type": "boolean"
        },
        "unsure": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "clipId",
        "raterId",
        "overall",
        "wordFlags",
        "finalContourMatch",
        "unsure",
        "durationMs",
        "createdAt"
      ]
    },
    "WordFlags": {
      "type": "object",
      "properties": {
        "wordIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sound",
              "stress",
              "pitch",
              "pause",
              "speed"
            ]
          }
        }
      },
      "required": [
        "wordIndex",
        "flags"
      ]
    },
    "AttemptAck": {
      "type": "object",
      "properties": {
        "lessonId": {
          "type": "string"
        },
        "segmentIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "voiced": {
          "type": "boolean"
        },
        "savedForEval": {
          "type": "boolean"
        }
      },
      "required": [
        "lessonId",
        "segmentIndex",
        "attempt",
        "durationMs",
        "voiced",
        "savedForEval"
      ]
    },
    "AppSettings": {
      "type": "object",
      "properties": {
        "playbackRate": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1
        },
        "repeat": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 3
            }
          ]
        },
        "recordFactor": {
          "type": "number",
          "minimum": 1,
          "maximum": 2
        },
        "dataDir": {
          "type": "string"
        },
        "accent": {
          "type": "string",
          "const": "US"
        }
      },
      "required": [
        "playbackRate",
        "repeat",
        "recordFactor",
        "dataDir",
        "accent"
      ]
    },
    "VideoPreview": {
      "type": "object",
      "properties": {
        "videoId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "durationSec": {
          "type": "number",
          "minimum": 0
        },
        "channel": {
          "type": "string"
        },
        "thumbnailUrl": {
          "type": "string"
        },
        "existingLessonId": {
          "type": "string"
        }
      },
      "required": [
        "videoId",
        "title",
        "durationSec"
      ]
    },
    "CreateLessonRequest": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "url"
      ]
    },
    "LessonListItem": {
      "type": "object",
      "properties": {
        "lesson": {
          "$ref": "#/$defs/LessonSummary"
        },
        "segmentCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "practicedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "firstUnpracticedIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "lesson",
        "segmentCount",
        "practicedCount",
        "firstUnpracticedIndex"
      ]
    },
    "LessonSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "videoId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "durationSec": {
          "type": "number",
          "minimum": 0
        },
        "thumbnailUrl": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/TimeRange"
        },
        "padMs": {
          "default": 150,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "downloading",
            "separating",
            "transcribing",
            "segmenting",
            "analyzing",
            "ready",
            "failed"
          ]
        },
        "error": {
          "$ref": "#/$defs/LessonError"
        },
        "audioQuality": {
          "$ref": "#/$defs/AudioQuality"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "videoId",
        "title",
        "durationSec",
        "range",
        "status",
        "createdAt"
      ]
    },
    "LessonProgress": {
      "type": "object",
      "properties": {
        "lessonId": {
          "type": "string"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SegmentProgress"
          }
        },
        "firstUnpracticedIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "lessonId",
        "segments",
        "firstUnpracticedIndex"
      ]
    },
    "SegmentProgress": {
      "type": "object",
      "properties": {
        "segmentIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "voicedAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "segmentIndex",
        "attempts",
        "voicedAttempts"
      ]
    },
    "SystemStatus": {
      "type": "object",
      "properties": {
        "models": {
          "$ref": "#/$defs/ModelStatuses"
        },
        "hasKey": {
          "type": "boolean"
        },
        "maskedKey": {
          "type": "string"
        },
        "activeDataDir": {
          "type": "string"
        }
      },
      "required": [
        "models",
        "hasKey",
        "activeDataDir"
      ]
    },
    "ModelStatuses": {
      "type": "object",
      "properties": {
        "demucs": {
          "type": "string",
          "enum": [
            "missing",
            "loading",
            "ready"
          ]
        },
        "whisper": {
          "type": "string",
          "enum": [
            "missing",
            "loading",
            "ready"
          ]
        },
        "wav2vec2": {
          "type": "string",
          "enum": [
            "missing",
            "loading",
            "ready"
          ]
        }
      },
      "required": [
        "demucs",
        "whisper",
        "wav2vec2"
      ]
    },
    "OpenAiKeyCheckRequest": {
      "type": "object",
      "properties": {
        "apiKey": {
          "type": "string"
        }
      }
    },
    "OpenAiKeyCheckResult": {
      "type": "object",
      "properties": {
        "valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "saved": {
          "type": "boolean"
        },
        "maskedKey": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "enum": [
            "invalid",
            "network",
            "no_key"
          ]
        }
      },
      "required": [
        "valid",
        "saved"
      ]
    },
    "UpdateSegmentTextRequest": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "text"
      ]
    },
    "ApiError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_request",
            "invalid_url",
            "channel_url",
            "video_unavailable",
            "live_video",
            "invalid_range",
            "duplicate_lesson",
            "not_found",
            "invalid_state",
            "invalid_segment",
            "unsupported_media",
            "payload_too_large",
            "recording_too_long",
            "busy",
            "no_openai_key",
            "upstream_error",
            "network_error",
            "invalid_settings",
            "forbidden_origin",
            "internal_error"
          ]
        },
        "message": {
          "type": "string"
        },
        "lessonId": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  }
}
